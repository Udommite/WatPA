{
    "name": "watassets",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "concurrently \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
        "build": "tsc --noEmit && vite build",
        "start": "tsx server/index.ts",
        "test": "tsx --test tests/*.test.ts",
        "seed": "tsx server/seed.ts",
        "setup:local": "tsx server/setup-local.ts",
        "format": "prettier --write src server shared tests vite.config.ts"
    },
    "dependencies": {
        "@electric-sql/pglite": "^0.3.0",
        "@fontsource/noto-sans-thai": "^5.2.0",
        "@vitejs/plugin-react": "^4.3.4",
        "bcryptjs": "^3.0.2",
        "cookie-parser": "^1.4.7",
        "dexie": "^4.0.11",
        "dexie-react-hooks": "^1.1.7",
        "dotenv": "^16.4.7",
        "exceljs": "^4.4.0",
        "express": "^5.1.0",
        "express-rate-limit": "^7.5.0",
        "helmet": "^8.1.0",
        "lucide-react": "^0.468.0",
        "multer": "^2.0.2",
        "papaparse": "^5.7.0",
        "pdfmake": "^0.3.14",
        "pg": "^8.13.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sharp": "^0.35.5",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/cookie-parser": "^1.4.8",
        "@types/express": "^5.0.0",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.13.0",
        "@types/papaparse": "^5.5.2",
        "@types/pdfmake": "^0.3.3",
        "@types/pg": "^8.11.11",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "concurrently": "^9.1.2",
        "fake-indexeddb": "^6.2.8",
        "prettier": "^3.9.10",
        "tsx": "^4.19.2",
        "typescript": "^5.7.3",
        "vite": "^6.1.0",
        "vite-plugin-pwa": "^0.21.1"
    }
}
